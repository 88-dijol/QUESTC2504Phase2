<Window x:Class="DTVPDProject.Pages.DesignIterationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      
        xmlns:local="clr-namespace:DTVPDProject.Pages"
        mc:Ignorable="d"
        Title="DesignIterationPageWindow" Height="450" Width="800">



    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>


            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" 
                  FontSize="24" 
                  FontWeight="Bold" 
                  Margin="-25,-97,45,117" TextAlignment="Center" Grid.RowSpan="2">
           Design Iteration
        </TextBlock>


        <StackPanel Grid.Row="2" Grid.Column="0" 
                   Orientation="Horizontal" 
                   Margin="10,10,-2,10">

        </StackPanel>

        <DataGrid Grid.Row="2" Grid.Column="0" 
                  Margin="114,55,112,103" 
                  AutoGenerateColumns="False" 
                  x:Name="grdDesignIterations"
                  ItemsSource="{Binding DesignIterations}"
                  SelectedItem="{Binding SelectedDesignIteration}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Iteration ID" Binding="{Binding IterationID}"/>
                <DataGridTextColumn Header="Twin ID" Binding="{Binding TwinID}"/>
                <DataGridTextColumn Header="Iteration Number" Binding="{Binding IterationNumber}"/>
                <DataGridTextColumn Header="Modified Model Path" Binding="{Binding ModelPath}"/>
                <DataGridTextColumn Header="Created At" Binding="{Binding CreatedAt}"/>
                <DataGridTextColumn Header="Success Count" Binding="{Binding SuccessCount}"/>
                <DataGridTextColumn Header="Failure Count" Binding="{Binding FailureCount}"/>

            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right" Margin="0,322,88,10" Width="169">
            <Button x:Name="btnClose"  
                    Content="Close" 
                    Width="72" 
                    Command="{Binding DeleteCommand}" 
                    Height="36" 
                    />
            
        </StackPanel>

    </Grid>
</Window>
