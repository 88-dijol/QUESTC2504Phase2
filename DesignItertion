using DTVPDProject.Repo;

namespace DTVPDProject.EFRepo
{
    public class EFDesignIterationsRepo : IDesignIterationRepo
    {
        private readonly DtvpdDbEntities _context;

        public EFDesignIterationsRepo()
        {
            _context = new DtvpdDbEntities();
        }

        public ObservableCollection<DesignIteration> ReadAll()
        {
            return new ObservableCollection<DesignIteration>(_context.DesignIterations.ToList());
        }


       

        public void Update(DesignIteration designIteration)
        {
            var existingDesignIteration = _context.DesignIterations.Find(designIteration.TwinID);
            if (existingDesignIteration != null)
            {
                _context.Entry(existingDesignIteration).CurrentValues.SetValues(designIteration);

                // Save changes to the database
                _context.SaveChanges();
            }
        }

       
